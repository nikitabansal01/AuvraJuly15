# AUVRA Backend - Environment Variables Template
# Copy this file to .env for local development
# Local application data requires a reachable PostgreSQL database.

# =============================================================================
# BASIC SETTINGS
# =============================================================================
PROJECT_NAME=Auvra Backend API
PROJECT_DESCRIPTION=Auvra Backend API Server
VERSION=1.0.0

# IMPORTANT: Set to "development" for local testing
# Production code automatically detects "production" from deployment platform
ENVIRONMENT=development

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE
# =============================================================================
# LOCAL DEVELOPMENT: Replace this with a reachable local PostgreSQL URL.
# PRODUCTION: Use the Supabase session-pooler URL. Both values below are
# required in production and may point to the same database.
DATABASE_URL=postgresql://user:password@localhost/auvra_db
LANGGRAPH_CHECKPOINT_POSTGRES_DSN=

# Local-only LangGraph fallback. Production never uses this file.
LANGGRAPH_CHECKPOINT_SQLITE_PATH=.langgraph/checkpoints/langgraph.sqlite

# =============================================================================
# FIREBASE (Optional for local development)
# =============================================================================
# Leave empty - auth is not required for session-based question endpoints
# Production uses deployment platform environment variables
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# =============================================================================
# AI SERVICES (Optional - recommendations won't generate without these)
# =============================================================================
# Leave empty - AI features will be skipped gracefully
OPENAI_API_KEY=
GROQ_API_KEY=
CURRENT_MODEL=gpt-4o
FALLBACK_MODEL=llama-3.3-70b

# =============================================================================
# GEMINI LLM (for "Others" free-text processing)
# =============================================================================
# Set ENABLE_LLM_OTHERS=true and provide GEMINI_API_KEY to enable LLM
# Hormone analysis still works using rule-based engine without API key!
ENABLE_LLM_OTHERS=true
LLM_OTHERS_TIMEOUT=30
GEMINI_API_KEY=

# =============================================================================
# RAG & VECTOR SEARCH (Not needed for question/hormone features)
# =============================================================================
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v0/scrape

# =============================================================================
# REDIS (Not needed for basic functionality)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# FILE UPLOADS
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
