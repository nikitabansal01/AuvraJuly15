System_Boundary(auvra, "AUVRA v2") {
  Container(mobile, "Mobile app", "React Native / Expo", "Typed presentation and offline-safe workflows")
  Container(api, "API", "FastAPI modular monolith", "Authentication, validation and synchronous commands/queries")
