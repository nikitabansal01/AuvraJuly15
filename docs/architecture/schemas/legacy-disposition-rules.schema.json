{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auvra.example/schemas/legacy-disposition-rules.schema.json",
  "title": "AUVRA v2 legacy disposition-rule catalog",
  "type": "object",
  "required": ["catalog_version", "source_contract", "rules"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_contract": {
      "type": "object",
      "required": ["application_row_total", "migration_revisions", "default_for_ambiguous_or_unconsented"],
      "additionalProperties": false,
      "properties": {
        "application_row_total": {"const": 1022},
        "migration_revisions": {"type": "array", "items": {"enum": ["20260801_0002", "20260808_0003"]}, "minItems": 2},
        "default_for_ambiguous_or_unconsented": {"enum": ["ARCHIVE", "QUARANTINE"]}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["legacy_table", "legacy_id_column", "disposition", "reason_code", "canonical_target_tables"],
        "additionalProperties": false,
        "properties": {
          "legacy_table": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "legacy_id_column": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "disposition": {"enum": ["MIGRATE", "ARCHIVE", "QUARANTINE", "REMOVE"]},
          "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "canonical_target_tables": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["app.users", "app.user_profiles", "app.onboarding_sessions", "app.onboarding_assessments", "ops.generation_jobs", "app.action_plans", "app.action_plan_item_variants", "app.action_item_events", "app.daily_reviews", "app.daily_review_items", "app.plan_refreshes"]}
          },
          "requires": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
